{
  "name": "obsidian-mcp",
  "version": "2.2.0",
  "description": "A safe, local MCP server for working with Obsidian vaults over stdio or Streamable HTTP",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "obsidian-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "MIGRATING.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": "./dist/main.js"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/make-executable.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts test/**/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage test/*.test.ts test/**/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/**/*.test.ts",
    "eval:validate": "node scripts/validate-evaluations.mjs",
    "package:check": "node scripts/check-package.mjs",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run eval:validate && npm run package:check",
    "start": "node dist/main.js serve",
    "prepack": "npm run build"
  },
  "keywords": [
    "obsidian",
    "mcp",
    "model-context-protocol",
    "ai",
    "notes",
    "knowledge-management",
    "streamable-http"
  ],
  "author": "Steven Stavrakis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StevenStavrakis/obsidian-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "yaml": "^2.8.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "packageManager": "pnpm@10.25.0+sha512.5e82639027af37cf832061bcc6d639c219634488e0f2baebe785028a793de7b525ffcd3f7ff574f5e9860654e098fe852ba8ac5dd5cefe1767d23a020a92f501"
}
